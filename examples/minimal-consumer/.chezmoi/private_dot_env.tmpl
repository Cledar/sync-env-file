APP_REQUEST_TIMEOUT_S=30

# --- Pattern 3: secrets from Azure Key Vault (| quote for special chars) ---
APP_DATABASE_PASSWORD={{ azureKeyVault "demo-app-database-password" | quote }}

# Connection-string-like value (needs quoting: $, +, =, ;)
APP_EVENTHUB_CONNECTION_STRING={{ azureKeyVault "demo-app-eventhub-connection-string" | quote }}
APP_EVENTHUB_SASL_USERNAME="$ConnectionString"

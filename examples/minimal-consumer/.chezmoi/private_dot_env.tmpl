{{- if env "UV_INDEX" }}
UV_INDEX={{ env "UV_INDEX" | quote }}
{{- end }}

# --- Pattern 2: non-secret defaults (committed template, safe literals) ---
APP_API_BASE_URL=https://api.example.com
